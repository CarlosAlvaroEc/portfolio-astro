---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "code'm up // DEV_WORKSPACE — CARLOS ALVARO" } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- Aplicación temprana del tema guardado (evita el parpadeo al cargar) -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme_preference') === 'obsidian') {
            document.documentElement.classList.add('obsidian-mode');
          }
        } catch (e) {
          /* localStorage no disponible */
        }
      })();
    </script>
  </head>
  <body class="splash-active bg-canvas font-sans text-sm leading-relaxed text-ink antialiased">
    <slot />
  </body>
</html>

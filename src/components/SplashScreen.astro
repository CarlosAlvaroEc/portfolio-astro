---
// SplashScreen.astro — overlay fijo a pantalla completa (módulo independiente).
// El lockup replica 1:1 las clases del titular del Hero para la continuidad
// visual. Salida: auto a los 1.2s o click / Enter / Espacio / Escape.
// Solo el FONDO se desvanece; el texto permanece opaco hasta que el titular
// del Hero ya es totalmente visible, y entonces se retira de golpe (mismos
// píxeles → swap invisible, sin hueco de opacidad).
---

<div
  id="splash-screen"
  class="splash-screen fixed inset-0 z-[9999] flex h-screen w-screen cursor-pointer items-center justify-center bg-canvas"
  role="button"
  tabindex="0"
  aria-label="Entrar al portafolio"
>
  <div class="splash-lockup px-4 text-center font-sans text-5xl font-black lowercase leading-none tracking-tight text-ink md:text-7xl">
    code<span class="text-signal">'</span>m up
  </div>
</div>

<noscript>
  <style>
    #splash-screen { display: none !important; }
    body.splash-active { overflow: auto !important; }
    [data-reveal] { opacity: 1 !important; translate: 0 0 !important; }
  </style>
</noscript>

<!-- Los estados del overlay (base, .is-leaving, .splash-hidden) viven en el
  <style is:inline> del <head> (selectores ID, misma especificidad en todas
  las fases y cobertura desde el fotograma 0). Aquí solo maquetación. -->

<script>
  (function () {
    var splash = document.getElementById('splash-screen');
    if (!splash) {
      document.documentElement.classList.add('is-revealed');
      document.body.classList.remove('splash-active');
      return;
    }
    var dismissed = false;
    var timer = null;

    function enterPortfolio() {
      if (dismissed) return;
      dismissed = true;
      if (timer) clearTimeout(timer);
      // Dispara la cascada fade-in-up del resto de la UI mientras el fondo funde.
      // El titular del Hero es opaco a los ~800ms (delay 200ms + 600ms).
      document.documentElement.classList.add('is-revealed');
      splash.classList.add('is-leaving');
      // Fase 2 a los 850ms: el titular ya es opaco y ocupa los mismos
      // píxeles, así que el fundido del contenedor es invisible (sin hueco).
      setTimeout(function () {
        splash.classList.add('splash-hidden');
        document.body.classList.remove('splash-active'); // rehabilita el scroll
        // Remover del DOM tras la transición (0.5s)
        setTimeout(function () {
          splash.style.display = 'none';
        }, 550);
      }, 850);
    }

    document.body.classList.add('splash-active');
    timer = setTimeout(enterPortfolio, 1200);
    splash.addEventListener('click', enterPortfolio);
    splash.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Escape') {
        e.preventDefault();
        enterPortfolio();
      }
    });
  })();
</script>

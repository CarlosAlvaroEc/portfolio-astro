---
// MetaStrip.astro — tira de especificaciones de ingeniería justo debajo del
// Hero, antes de los proyectos.
---

<section aria-label="Metadatos técnicos" data-reveal="rise" style="--reveal-delay:500ms" class="mx-auto my-8 grid w-full max-w-4xl grid-cols-2 gap-px border border-line bg-line text-left text-xs md:grid-cols-4">
  <div class="bg-surface p-4">
    <div class="font-mono text-xs uppercase tracking-wider text-meta">Titular</div>
    <div class="mt-1 font-medium text-ink">Carlos Alvaro</div>
  </div>
  <div class="bg-surface p-4">
    <div class="font-mono text-xs uppercase tracking-wider text-meta">Formación</div>
    <div class="mt-1 font-medium text-ink">ESPOCH (Software)</div>
  </div>
  <div class="bg-surface p-4">
    <div class="font-mono text-xs uppercase tracking-wider text-meta">Entorno</div>
    <div class="mt-1 font-medium text-ink">Fedora Linux</div>
  </div>
  <div class="bg-surface p-4">
    <div class="font-mono text-xs uppercase tracking-wider text-meta">Jurisdicción</div>
    <div class="mt-1 font-medium text-ink">Chimborazo, Ecuador</div>
  </div>
</section>
